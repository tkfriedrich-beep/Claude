# Copy to services/control-plane/.env — never commit real values.

# --- Model providers (optional; demo mode works without any of these) ---
# Enables the Claude runtime (official Agent SDK). Alternatively authenticate the `claude` CLI.
ANTHROPIC_API_KEY=

# --- Control plane ---
# COCKPIT_DATA_DIR=/absolute/path/for/local/state     # default: <repo>/data/local
# COCKPIT_PORT=8787
# COCKPIT_SAFE_MODE_DEFAULT=true
# COCKPIT_DAILY_BUDGET_USD=5.00
# COCKPIT_RUN_BUDGET_USD=1.00

# --- Web ---
# NEXT_PUBLIC_API_URL=http://localhost:8787

# --- n8n webhook HMAC secrets (referenced by name at registration; value only lives here) ---
# COCKPIT_N8N_SECRET_MYFLOW=replace-me
