#!/bin/bash
# Otto (Phone) — launches the AgenticOS Cockpit bound to all interfaces (make phone) so you can
# open it on your phone over Tailscale. Same repo/setup as the regular Otto; the only difference
# is it serves on the network and prints the URL to open on your phone. Quit the Terminal window
# to stop it.

set -uo pipefail

# GUI-launched apps get a minimal PATH — add the usual homes for uv / node / pnpm / brew / tailscale.
export PNPM_HOME="${PNPM_HOME:-$HOME/Library/pnpm}"
export PATH="$HOME/.local/bin:$PNPM_HOME:$HOME/Library/pnpm:$HOME/.local/share/pnpm:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# Absolute path to this script (works before AND after the Terminal relaunch).
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# First entry: relaunch inside Terminal.app so setup progress and logs are visible.
if [ "${OTTO_IN_TERMINAL:-0}" != "1" ]; then
  osascript >/dev/null 2>&1 <<OSA
tell application "Terminal"
  activate
  do script "OTTO_IN_TERMINAL=1 " & quoted form of "$SELF"
end tell
OSA
  exit 0
fi

say()  { printf "\n\033[1;36m▶ %s\033[0m\n" "$*"; }
gold() { printf "\n\033[1;33m%s\033[0m\n" "$*"; }
die()  {
  local one="${1//$'\n'/ }"; one="${one//\"/\'}"
  osascript -e "display alert \"Otto (Phone)\" message \"$one\"" >/dev/null 2>&1
  printf "\n\033[1;31m✖ %s\033[0m\n\n" "$1"
  echo "Press any key to close this window…"; read -rn1; exit 1
}
need() { command -v "$1" >/dev/null 2>&1; }
is_repo() { [ -n "$1" ] && [ -f "$1/Makefile" ] && grep -q "AgenticOS Cockpit" "$1/Makefile" 2>/dev/null; }

# Print this Mac's Tailscale IPv4 (100.x.y.z), trying the CLI on PATH then the app bundle.
ts_ip() {
  local c
  for c in tailscale /Applications/Tailscale.app/Contents/MacOS/Tailscale \
           /usr/local/bin/tailscale /opt/homebrew/bin/tailscale; do
    if [ -x "$c" ] || command -v "$c" >/dev/null 2>&1; then
      "$c" ip -4 2>/dev/null | head -n1 && return 0
    fi
  done
  return 1
}

REPO_URL="https://github.com/tkfriedrich-beep/Claude.git"
CFG="$HOME/.otto-repo"   # shared with the regular Otto launcher

# 1) locate the repo -----------------------------------------------------------
REPO="${COCKPIT_HOME:-}"
if [ -z "$REPO" ]; then
  INPLACE="$(cd "$(dirname "$SELF")/../../../.." 2>/dev/null && pwd || true)"
  is_repo "$INPLACE" && REPO="$INPLACE"
fi
[ -z "$REPO" ] && [ -f "$CFG" ] && REPO="$(cat "$CFG")"
is_repo "$REPO" || REPO=""
if [ -z "$REPO" ]; then
  for c in "$HOME/Claude" "$HOME/Desktop/Claude" "$HOME/Developer/Claude" \
           "$HOME/code/Claude" "$HOME/Documents/Claude" "$HOME/projects/Claude" "$HOME/src/Claude"; do
    is_repo "$c" && { REPO="$c"; break; }
  done
fi

# 2) offer to clone (or pick) if still not found -------------------------------
if [ -z "$REPO" ]; then
  CHOICE="$(osascript -e 'button returned of (display dialog "AgenticOS Cockpit isn'\''t set up on this Mac yet." buttons {"Choose folder…","Clone to ~/Claude"} default button "Clone to ~/Claude" with title "Otto (Phone)")' 2>/dev/null || true)"
  if [ "$CHOICE" = "Clone to ~/Claude" ]; then
    need git || die "git is required. Install the Xcode Command Line Tools:  xcode-select --install"
    say "Cloning AgenticOS Cockpit → ~/Claude (first time only)…"
    git clone "$REPO_URL" "$HOME/Claude" || die "git clone failed — check your network and try again."
    REPO="$HOME/Claude"
  else
    REPO="$(osascript -e 'POSIX path of (choose folder with prompt "Select your AgenticOS Cockpit folder (the one with the Makefile)")' 2>/dev/null || true)"
    [ -n "$REPO" ] || exit 0
  fi
fi
is_repo "$REPO" || die "That folder isn't the Cockpit repo (no Makefile)."
echo "$REPO" > "$CFG"
cd "$REPO" || die "Cannot enter $REPO"
say "Using repo: $REPO"

# 3) toolchain -----------------------------------------------------------------
need uv || die "$(printf 'Otto needs uv (the Python toolchain). Install it, then reopen Otto:\n\n  curl -LsSf https://astral.sh/uv/install.sh | sh')"
need node || die "$(printf 'Otto needs Node.js 20 or newer. Install it, then reopen Otto:\n\n  Download: https://nodejs.org   (or, with Homebrew:  brew install node)')"
if ! need pnpm; then
  say "Enabling pnpm (bundled with Node via corepack)…"
  corepack enable pnpm >/dev/null 2>&1 || corepack enable >/dev/null 2>&1 || true
fi
need pnpm || die "$(printf 'Otto needs pnpm. Pick ONE, then reopen Otto:\n\n  • corepack (ships with Node):  sudo corepack enable\n  • Homebrew:                    brew install pnpm\n  • Standalone (no admin):       curl -fsSL https://get.pnpm.io/install.sh | sh -\n\nAvoid  sudo npm i -g pnpm  — it leaves root-owned files that cause errors later.')"

# 4) first-run setup + seed ----------------------------------------------------
if [ ! -d "services/control-plane/.venv" ] || [ ! -d "node_modules" ]; then
  say "First run — installing dependencies (a few minutes)…"
  make setup || die "Setup failed — see the messages above."
fi
if [ ! -f "data/local/cockpit.db" ]; then
  say "Seeding the demo workspace…"
  make demo || true
fi

# 5) show the phone URL, then run both servers on all interfaces (blocks) -------
say "Starting Otto for phone access — serving on your network (make phone)."
TS_IP="$(ts_ip || true)"
if [ -n "$TS_IP" ]; then
  gold "📱  On your phone (Tailscale on), open:  http://$TS_IP:3000"
else
  gold "$(printf '📱  On your phone, open:  http://<this-Mac-Tailscale-IP>:3000\n    Find the IP (looks like 100.x.y.z) in the Tailscale menu-bar app.\n    If Tailscale isn'\''t installed/running yet, start it, then reopen this app.')"
fi
say "This Mac can also use http://localhost:3000. Only localhost + your tailnet can reach Otto (a random Wi-Fi neighbor gets 403). Keep Safe Mode ON. Leave this window open; close it to quit."

# Open the cockpit on the Mac too, once the web server answers.
( for _ in $(seq 1 120); do
    if curl -sf http://localhost:3000 >/dev/null 2>&1; then open "http://localhost:3000"; break; fi
    sleep 1
  done ) &
exec make phone
